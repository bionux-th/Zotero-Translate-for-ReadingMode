{
  "manifest_version": 2,
  "name": "Translate for ReadingMode",
  "version": "1.1.0",
  "description": "Translate Zotero PDF reading mode with local and online translation services",
  "author": "Translate for ReadingMode",
  "homepage_url": "https://github.com/bionux-th/Zotero-Translate-for-ReadingMode",
  "icons": {
    "48": "content/icons/icon-48.png",
